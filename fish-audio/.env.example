# Copy to .env and fill in. Examples load .env from their folder or any parent folder.

# --- Fish Audio (required) -------------------------------------------------
# https://fish.audio/app/api-keys
FISH_API_KEY=

# TTS model: s2.1-pro (recommended) | s2.1-pro-free (free, no latency guarantees) | s2-pro | s1 (legacy)
FISH_TTS_MODEL=s2.1-pro

# Optional default voice (voice model id from https://fish.audio or from 03-npc-voice-factory).
# Leave empty to use Fish's default voice.
FISH_VOICE_ID=

# Agent id for 04-agent-web / 05-agent-custom-llm (create in the console or with the example's setup script)
FISH_AGENT_ID=

# --- LLM (optional; with no key, examples use a MOCKUP reply) --------------
# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Together, Ollama, Anthropic's OpenAI-compat API, ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- 05-agent-custom-llm only ---------------------------------------------
# Shared secret Fish sends to your custom LLM server (pick any random string)
CUSTOM_LLM_API_KEY=
# Public HTTPS URL of your server, e.g. from `cloudflared tunnel --url http://localhost:8000`
PUBLIC_URL=
